{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/context_budget.py",
        "matcher": "Read|Grep|Shell|Glob|Task",
        "failClosed": false
      },
      {
        "command": ".cursor/hooks/require_subagent.py",
        "matcher": "Read|Grep|Shell|Glob",
        "failClosed": false
      },
      {
        "command": ".cursor/hooks/guard_reads.py",
        "matcher": "Read",
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/limit_verbose_output.py",
        "matcher": "*",
        "failClosed": false
      }
    ]
  }
}
