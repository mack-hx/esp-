# ESP-IDF 默认配置 (每次 PlatformIO 重新配置时都会读取本文件, 作为默认值)
#
# 生效规则: sdkconfig.defaults < sdkconfig.esp32-s3-devkitc-1
# 也就是说 sdkconfig.<env> 优先级更高。本文件保证"新环境/删掉 sdkconfig 后重新生成"也能得到正确配置。
# 平时改配置建议改 sdkconfig.esp32-s3-devkitc-1 (它会被 kconfig 规范化, 不会写非法组合)。

# ---- Flash: ESP32-S3R8N8 是 8MB ----
# 必须与 board JSON 的 upload.flash_size 保持一致, 否则 PlatformIO 会报
# "Flash memory size mismatch detected" 警告, 并用错分区表偏移算地址
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# ---- 分区表 ----
# 用工程根目录的 partitions.csv (8MB 自定义表: nvs/otadata/phy/ota_0/ota_1/storage)
# 路径相对于工程根目录, ESP-IDF 直接读取源目录里的 CSV, 不需要先复制到 build 目录
#
# ⚠ 关键: PARTITION_TABLE_CUSTOM 必须 =y, 否则 Kconfig 会让 PARTITION_TABLE_FILENAME
#   退回 partitions_singleapp.csv, 即使 CUSTOM_FILENAME 填了也会被忽略
#   (之前就是踩了这个坑, 只剩 1MB 单应用分区 / 约 200KB)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---- WiFi: 开热点 (AP 模式) 给手机/电脑连, 浏览器调参 ----
# 依赖链: CONFIG_ESP_WIFI_ENABLED -> wifi 组件 (libnet80211 等)
# http_server 组件默认就编译 (无 Kconfig 开关), 只要 REQUIRES 里写上即可
CONFIG_ESP_WIFI_ENABLED=y

# WiFi 省电模式: 关闭可省一点电, 但会略微增加调参网页的响应延迟
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set

# 热点信标间隔 (100ms, 默认 100)
CONFIG_ESP_WIFI_BEACON_INTVL=100

# 主机名 (仅 STA 模式有意义, AP 模式用 SSID)
CONFIG_LWIP_LOCAL_HOSTNAME="balance-robot"

# ---- 关闭蓝牙 (已弃用 BLE 调参方案, 改用 WiFi 网页调参) ----
# 注释掉/关闭后可省约 12MB 未压缩的 libbt.a, 编译时间和固件体积都受益
# CONFIG_BT_ENABLED is not set
# CONFIG_BT_BLUEDROID_ENABLED is not set
# CONFIG_BT_NIMBLE_ENABLED is not set
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
# CONFIG_BTU_TASK_STACK_SIZE is not set
# CONFIG_BT_GATTS_ENABLE is not set

# ---- MQTT: OneNet 物模型客户端 (mqtt_client.c) ----
# 走标准 MQTT 3.1.1, 不走 WebSocket (ESP32 直接 TCP 即可)
CONFIG_MQTT_PROTOCOL_311=y
# 关闭 WebSocket, 减少未用代码体积
CONFIG_MQTT_TRANSPORT_WEBSOCKET_DISABLED=y

# ---- 实时性: 把网络协议栈赶出 core 1 (2026-10-26) ----
# 平衡控制任务 (优先级 7, 绑在 core 1) 的周期是 10ms, 一次都不能被抢。
# lwIP 的 tcpip 任务优先级 18, 默认两个 core 都能跑 → 收发 MQTT 时会抢占
# core 1 上的控制任务 → 控制周期抖到 20~30ms → 车"一碰/一走就剧烈抖"。
# WiFi 任务本来就固定在 core 0 (CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0),
# 所以把 tcpip 任务也绑到 core 0, core 1 就只剩控制任务和低优先级任务。
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# ---- 控制台波特率 230400 ----
# 100Hz 的 TRACE 输出 = 100 行/s x 约 125 字节 = 12.5KB/s,
# 115200 只有 11.5KB/s → 装不下, 会丢行, 采样率就假了。
#
# ⚠ 必须同时开 ESP_CONSOLE_UART_CUSTOM: "ESP_CONSOLE_UART_BAUDRATE"
#   这个符号只有 CUSTOM 打开时才有 prompt, 否则 kconfig 把它当
#   "不可见符号" → 每次编译都被重置回默认 115200 (改 sdkconfig 也白改)。
# 引脚保持 ESP32-S3 的默认 UART0 (TX=GPIO43 / RX=GPIO44), 跟原来一样。
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=43
CONFIG_ESP_CONSOLE_UART_RX_GPIO=44
CONFIG_ESP_CONSOLE_UART_BAUDRATE=230400
